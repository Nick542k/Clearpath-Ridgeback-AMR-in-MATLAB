<?xml version="1.0"?>
<!-- Converted from ridgeback.sdf (SDF 1.9, Ignition Gazebo).
     SDF link poses are in the model frame; URDF joint origins are relative to
     the parent, so base_link (z = 0.22) was subtracted from every child pose. -->
<robot name="ridgeback">

  <material name="base_grey"><color rgba="0.2 0.2 0.2 1"/></material>
  <material name="wheel_black"><color rgba="0.05 0.05 0.05 1"/></material>

  <!-- ================= base ================= -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="40"/>
      <inertia ixx="2.0" iyy="3.0" izz="4.0" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <collision>
      <geometry><box size="0.96 0.64 0.24"/></geometry>
    </collision>
    <visual>
      <geometry><box size="0.96 0.64 0.24"/></geometry>
      <material name="base_grey"/>
    </visual>
  </link>

  <!-- ================= wheels ================= -->
  <link name="front_left_wheel">
    <inertial>
      <mass value="2"/>
      <inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <collision>
      <geometry><cylinder radius="0.12" length="0.08"/></geometry>
    </collision>
    <visual>
      <geometry><cylinder radius="0.12" length="0.08"/></geometry>
      <material name="wheel_black"/>
    </visual>
  </link>

  <link name="front_right_wheel">
    <inertial>
      <mass value="2"/>
      <inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <collision>
      <geometry><cylinder radius="0.12" length="0.08"/></geometry>
    </collision>
    <visual>
      <geometry><cylinder radius="0.12" length="0.08"/></geometry>
      <material name="wheel_black"/>
    </visual>
  </link>

  <link name="rear_left_wheel">
    <inertial>
      <mass value="2"/>
      <inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <collision>
      <geometry><cylinder radius="0.12" length="0.08"/></geometry>
    </collision>
    <visual>
      <geometry><cylinder radius="0.12" length="0.08"/></geometry>
      <material name="wheel_black"/>
    </visual>
  </link>

  <link name="rear_right_wheel">
    <inertial>
      <mass value="2"/>
      <inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <collision>
      <geometry><cylinder radius="0.12" length="0.08"/></geometry>
    </collision>
    <visual>
      <geometry><cylinder radius="0.12" length="0.08"/></geometry>
      <material name="wheel_black"/>
    </visual>
  </link>

  <!-- Wheel joints: "continuous" replaces the SDF revolute with +/-1e16 limits.
       Axis 0 0 1 is in the child frame, which is rolled 90 deg about X. -->
  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_left_wheel"/>
    <origin xyz="0.3 0.35 -0.10" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_right_wheel"/>
    <origin xyz="0.3 -0.35 -0.10" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_wheel"/>
    <origin xyz="-0.3 0.35 -0.10" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_wheel"/>
    <origin xyz="-0.3 -0.35 -0.10" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- ================= sensors ================= -->
  <link name="imu_link">
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
  </joint>

  <link name="lidar_link">
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.4 0 0.14" rpy="0 0 0"/>
  </joint>

  <!-- ================= Gazebo-only extensions (ignored by MATLAB/RViz) ================= -->
  <gazebo reference="base_link">
    <material>
      <ambient>0.15 0.15 0.15 1</ambient>
      <diffuse>0.2 0.2 0.2 1</diffuse>
    </material>
  </gazebo>

  <gazebo reference="front_left_wheel"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  <gazebo reference="front_right_wheel"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  <gazebo reference="rear_left_wheel"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  <gazebo reference="rear_right_wheel"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <topic>imu_sensor/imu</topic>
    </sensor>
  </gazebo>

  <gazebo reference="lidar_link">
    <sensor name="gpu_lidar" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>20</update_rate>
      <topic>gpu_lidar/scan</topic>
      <visualize>true</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-2.356</min_angle>
            <max_angle>2.356</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.08</min>
          <max>40.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin filename="ignition-gazebo-diff-drive-system" name="ignition::gazebo::systems::DiffDrive">
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>0.7</wheel_separation>
      <wheel_radius>0.12</wheel_radius>
      <odom_publish_frequency>50</odom_publish_frequency>
      <topic>/model/ridgeback/cmd_vel</topic>
      <odom_topic>odometry</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
    </plugin>
    <plugin filename="ignition-gazebo-joint-state-publisher-system" name="ignition::gazebo::systems::JointStatePublisher"/>
  </gazebo>

</robot>
